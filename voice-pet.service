[Unit]
Description=voice-pet MVP service
After=sound.target network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/.picoclaw/voice-pet
Environment=PYTHONPATH=%h/.picoclaw/voice-pet/src
EnvironmentFile=-%h/.picoclaw/voice-pet/voice-pet.env
ExecStart=/usr/bin/python3 -m voice_pet.main --config %h/.picoclaw/voice-pet/config.json
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
